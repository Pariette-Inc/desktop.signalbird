{
  "name": "signalbird-desktop",
  "productName": "Signalbird",
  "version": "1.0.0",
  "description": "Signalbird masaüstü uygulaması — panel + menü çubuğunda telsiz ve bildirimler",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:universal": "electron-builder --mac --universal"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.signalbird.desktop",
    "productName": "Signalbird",
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"]
    }
  }
}
